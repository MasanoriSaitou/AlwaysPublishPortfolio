@using 書籍検索アプリ_移植元Java.Models.beans
@model SearchInformationBean
@{
    ViewData["Title"] = "BookSearchScreen";
}

<h2>
	書籍検索画面
</h2>
<link rel="stylesheet" href="~/css/bookSearch.css" />
<form method="post" asp-controller="BookSearch" asp-action="BookSearchScreen">

	<!-- キーワード入力テキストボックス -->
	本を検索する
	<input type="text" id="keyWord" name="keyWord" value="@Model?.KeyWord" placeholder="キーワードを入力" autofocus>

	<!-- キーワード検索ボタン -->
	<input type="submit" name="pushedButton" value="検索" id="searchButton">

	<!-- 全件表示ボタン -->
	<input type="submit" name="pushedButton" value="全件表示" id="allDisplayButton">

	<!-- Webで検索ボタン -->
	<input type="button" name="pushedButton" value="Webで検索" id="searchEngineButton" onclick="openGoogle();">

	<!-- ラジオボタン -->
	<div>
		<input type="radio" id="keyWordSearch" name="pushedRadio" value="keyWordSearch"
			   @(Model?.PushedRadio == "keyWordSearch" || Model == null? "checked" : "")>
		<label for="keyWordSearch">キーワードで検索</label>
		<input type="radio" id="titleSearch" name="pushedRadio" value="titleSearch"
			   @(Model?.PushedRadio == "titleSearch" ? "checked" : "")>
		<label for="titleSearch">本のタイトルで検索</label>
	</div>
	<!-- チェックボックス -->
	<div>
		<input type="checkbox" id="fromFileSearch" name="pushedChkBox" value="fromFileSearch"
			   @(Model?.PushedChkBox?.Contains("fromFileSearch") == true || Model == null? "checked" : "")>
		<label for="fromFileSearch">ファイルから検索</label>
		<input type="checkbox" id="fromDataBaseSearch" name="pushedChkBox" value="fromDataBaseSearch"
			   @(Model?.PushedChkBox?.Contains("fromDataBaseSearch") == true ? "checked" : "")>
		<label for="fromDataBaseSearch">データベースから検索</label>
	</div>

	<h2 id="result">
		検索結果( @(Model == null? 0 : Model.SearchResultList?.Count) 件) <br>
	</h2>

	@if (Model != null && Model.SearchResultList?.Count > 0){

		<div id="table">
			<table>
				<tr>
					<th>架空ISBNコード</th>
					<th>タイトル</th>
					<th>著者</th>
					<th>発刊日</th>
				</tr>

				@for (int i = 0; i < Model.SearchResultList?.Count; i++) {

					<tr>
						<td>
							<a style="width:100%; height:100%; display:block;"
							   asp-controller="SearchResult"
							   asp-action="SearchResultScreen"
							   asp-route-selectNo="@i">
							@Model.SearchResultList[i]?.FictitiousISBN</a></td>
						<td>@Model.SearchResultList[i]?.BookName</td>
						<td>@Model.SearchResultList[i]?.Author</td>
						<td>@Model.SearchResultList[i]?.PublicationDate?.ToString("yyyy/MM/dd")</td>
					</tr>
				}
			</table>
		</div>
	} else if (Model != null && Model.SearchResultList?.Count <= 0) {

		<h3 id="canNotFind">
			検索しましたが、ヒットしませんでした。
		</h3>
	}
</form>
<script src="~/js/main.js"></script>